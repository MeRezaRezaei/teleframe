{
    "name": "merezarezaei/teleframe",
    "description": "Unified Telegram engine and framework: MTProto 2.0 (user + bot), Bot HTTP API, Mini App auth, Passport KYC, consumer layer (ingest, bus, daemon, backfill, backup) and a one-class handler facade (Teleframe)",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "telegram",
        "mtproto",
        "bot-api",
        "teleframe",
        "teleclient",
        "laravel"
    ],
    "homepage": "https://github.com/MeRezaRezaei/teleframe",
    "support": {
        "issues": "https://github.com/MeRezaRezaei/teleframe/issues",
        "source": "https://github.com/MeRezaRezaei/teleframe"
    },
    "authors": [
        {
            "name": "Teleframe Team",
            "homepage": "https://github.com/MeRezaRezaei"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gmp": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ext-zlib": "*",
        "laravel/framework": "^13.0",
        "phpseclib/phpseclib": "^3.0",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "predis/predis": "^3.6",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "phpunit/phpunit": "^12.0",
        "spaze/phpstan-disallowed-calls": "^4.14",
        "spatie/laravel-ignition": "^2.4",
        "orchestra/testbench": "^10.0 || ^11.0",
        "chillerlan/php-qrcode": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "MeRezaRezaei\\Teleframe\\Core\\": "src/Core/",
            "MeRezaRezaei\\Teleframe\\Bot\\": "src/Bot/",
            "MeRezaRezaei\\Teleframe\\Laravel\\": "src/Laravel/",
            "MeRezaRezaei\\Teleframe\\Schema\\": "src/Schema/",
            "MeRezaRezaei\\Teleframe\\": "src/Teleframe/",
            "MeRezaRezaei\\Teleframe\\Schema\\Generated\\": "generated/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "MeRezaRezaei\\Teleframe\\Tests\\": "tests/",
            "MeRezaRezaei\\Teleframe\\Core\\Tests\\": "tests/Core/",
            "MeRezaRezaei\\Teleframe\\Bot\\Tests\\": "tests/Bot/",
            "MeRezaRezaei\\Teleframe\\Laravel\\Tests\\": "tests/Laravel/",
            "MeRezaRezaei\\Teleframe\\Schema\\Tests\\": "tests/Schema/"
        }
    },
    "bin": [
        "bin/teleframe"
    ],
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": "phpunit",
        "stan": "phpstan analyse -c phpstan.neon.dist",
        "verify": [
            "@test",
            "@stan"
        ]
    },
    "extra": {
        "telegram-layer": 229,
        "laravel": {
            "dont-discover": [],
            "providers": [
                "MeRezaRezaei\\Teleframe\\Laravel\\Providers\\TeleframeServiceProvider"
            ],
            "aliases": {
                "TF": "MeRezaRezaei\\Teleframe\\Laravel\\Facades\\TF",
                "Teleframe": "MeRezaRezaei\\Teleframe\\Laravel\\Facades\\Teleframe"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
