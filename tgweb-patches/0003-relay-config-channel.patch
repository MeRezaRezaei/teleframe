+/**
+ * Server-key map that materializes the lazily-derived relay key before EVERY
+ * access: get, has, forEach, entries, keys, values and Symbol.iterator all
+ * ensure it first, so membership and iteration can never miss it (W-39) —
+ * callers are not limited to a strict get().
+ */
+class RelayAwareServerKeys extends Map<bigint, { n: bigint; e: number }> {
+  private ensureRelayKey(): void {
+    const relayKey = getRelayServerKey();
+    if (relayKey) {
+      this.set(relayKey.fingerprint, { n: relayKey.n, e: relayKey.e });
+    }
+  }
+
+  override get(fingerprint: bigint) {
+    this.ensureRelayKey();
+    return super.get(fingerprint);
+  }
+
+  override has(fingerprint: bigint) {
+    this.ensureRelayKey();
+    return super.has(fingerprint);
+  }
+
+  override forEach(callbackfn: (value: { n: bigint; e: number }, key: bigint, map: Map<bigint, { n: bigint; e: number }>) => void, thisArg?: unknown): void {
+    this.ensureRelayKey();
+    super.forEach(callbackfn, thisArg);
+  }
+
+  override entries(): IterableIterator<[bigint, { n: bigint; e: number }]> {
+    this.ensureRelayKey();
+    return super.entries();
