+ * ORDERING REQUIREMENT (enforced by build, guarded at runtime): the
+ * relay-bootstrap.js `<script src>` that bin/build-tgweb.sh injects into
+ * `<head>` MUST execute BEFORE initApi / initApiOnMasterTab runs — this
+ * function reads its baked globals from `globalThis` at collection time only,
+ * and a bootstrap script running after initApi is missed silently, leaving
+ * the client on stock Telegram transport. The build injects the script tag
+ * ahead of the module script, so it holds by construction; the guard below
+ * turns a silent miss (a script-order or extraction problem elsewhere) into
+ * a visible console warning instead.
+ */
+function collectRelayConfig(): RelayConfig | undefined {
+  const webLiveEndpoint = (globalThis as { TELEGRAM_WEB_LIVE_ENDPOINT?: string }).TELEGRAM_WEB_LIVE_ENDPOINT
+    || import.meta.env.VITE_TELEGRAM_WEB_LIVE_ENDPOINT || undefined;
+  const serverKey = (globalThis as { TELEGRAM_WEB_RELAY_SERVER_KEY?: string }).TELEGRAM_WEB_RELAY_SERVER_KEY;
+  const ticketUrl = (globalThis as { TELEGRAM_WEB_RELAY_TICKET_URL?: string }).TELEGRAM_WEB_RELAY_TICKET_URL || undefined;
+  const bearer = (globalThis as { TELEGRAM_WEB_RELAY_BEARER?: string }).TELEGRAM_WEB_RELAY_BEARER || undefined;
+  if (!webLiveEndpoint && import.meta.env.VITE_TELEGRAM_WEB_LIVE_ENDPOINT) {
+    console.warn('[teleframe] VITE_TELEGRAM_WEB_LIVE_ENDPOINT is set but the relay-bootstrap.js '
+      + 'global was absent when initApi collected the relay config (script-order/extraction '
+      + 'problem) — relay wiring skipped; client stays on stock transport.');
+  }
+  return webLiveEndpoint || serverKey || ticketUrl ? { webLiveEndpoint, serverKey, ticketUrl, bearer } : undefined;
+}
