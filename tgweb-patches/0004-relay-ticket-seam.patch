+/**
+ * The same-origin Laravel endpoint that mints a one-shot relay ticket
+ * (`POST /teleframe/accounts/{id}/ticket`), when the served client has been
+ * pointed at the package's relay. Read from the `TELEGRAM_WEB_RELAY_TICKET_URL`
+ * runtime global (baked into relay-bootstrap.js like the endpoint, and
+ * forwarded into the worker via the relay-config channel). Undefined means the
+ * client dials without a ticket.
+ */
+export function getRelayTicketUrl(): string | undefined {
+  if (typeof globalThis !== 'undefined') {
+    const runtimeValue = (globalThis as { TELEGRAM_WEB_RELAY_TICKET_URL?: string }).TELEGRAM_WEB_RELAY_TICKET_URL;
+    if (runtimeValue) {
+      return runtimeValue;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Optional bearer token for the ticket-mint fetch (`TELEGRAM_WEB_RELAY_BEARER`).
+ * In production the mint rides the page's own host session (same-origin
+ * fetch with cookies); the bearer exists for token-authenticated hosts (and
+ * headless harnesses that carry a Sanctum token instead of a browser login).
+ */
+export function getRelayBearer(): string | undefined {
+  if (typeof globalThis !== 'undefined') {
+    const runtimeValue = (globalThis as { TELEGRAM_WEB_RELAY_BEARER?: string }).TELEGRAM_WEB_RELAY_BEARER;
+    if (runtimeValue) {
+      return runtimeValue;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Mints a fresh one-shot relay ticket for the next socket session. The relay
+ * redeems exactly one ticket per WS upgrade (W-02), so each connection mints
+ * again — reuses, close-then-reconnect, and multi-connection all get new
+ * tickets and never replay a spent one. Returns undefined when no mint URL is
+ * configured (stock transport / no relay) or the mint fails (the dial then
+ * proceeds ticketless and the relay's 401 surfaces honestly).
+ */
+export async function obtainRelayTicket(): Promise<string | undefined> {
+  const ticketUrl = getRelayTicketUrl();
+  if (!ticketUrl) {
+    return undefined;
+  }
+  try {
+    const headers: Record<string, string> = { 'Content-Type': 'application/json' };
+    const bearer = getRelayBearer();
+    if (bearer) {
+      headers.Authorization = `Bearer ${bearer}`;
+    }
+    const response = await fetch(ticketUrl, { method: 'POST', headers, credentials: 'same-origin' });
+    if (!response.ok) {
+      return undefined;
+    }
+    const body = (await response.json()) as { ticket?: string };
+    return body.ticket || undefined;
+  } catch {
+    return undefined;
+  }
+}
