+const BAKED_TELEGRAM_WEB_LIVE_ENDPOINT = import.meta.env.VITE_TELEGRAM_WEB_LIVE_ENDPOINT || undefined;
+
+function endpointToUrl(endpoint: string) {
+  return endpoint.includes('://') ? endpoint : `wss://${endpoint}/apiws`;
+}
+
+/**
+ * Returns the relay endpoint when the client has been pointed at the package's
+ * relay instead of Telegram's own servers. Prefers the runtime global
+ * `TELEGRAM_WEB_LIVE_ENDPOINT` (on the main thread that is `window`), falling
+ * back to the endpoint baked into the bundle at build time via the
+ * `TELEGRAM_WEB_LIVE_ENDPOINT` / `TG_DC_HOST` env vars. Undefined means the
+ * stock Telegram endpoints are used.
+ */
+export function getTelegramWebLiveEndpoint(): string | undefined {
+  if (typeof globalThis !== 'undefined') {
+    const runtimeValue = (globalThis as { TELEGRAM_WEB_LIVE_ENDPOINT?: string }).TELEGRAM_WEB_LIVE_ENDPOINT;
+    if (runtimeValue) {
+      return runtimeValue;
+    }
+  }
+  return BAKED_TELEGRAM_WEB_LIVE_ENDPOINT;
+}
+
+/**
+ * Returns the connectable live URL for one transport family, when the client
+ * is pointed at the relay. A `ws(s)` endpoint feeds the WebSocket transport,
+ * an `http(s)` endpoint feeds the HTTP long-poll transport, and a bare
+ * hostname resolves to both (`wss://host/apiws` and `https://host/apiw1`).
+ * Returns undefined when the endpoint does not match this transport family, so
+ * each transport keeps its stock fallback URL.
+ */
+export function getTelegramWebLiveUrl(transportScheme: 'ws' | 'http'): string | undefined {
+  const endpoint = getTelegramWebLiveEndpoint();
+  if (!endpoint) {
+    return undefined;
+  }
+  if (endpoint.startsWith('ws://') || endpoint.startsWith('wss://')) {
+    return transportScheme === 'ws' ? endpoint : undefined;
+  }
+  if (endpoint.startsWith('http://') || endpoint.startsWith('https://')) {
+    return transportScheme === 'http' ? endpoint : undefined;
+  }
+  const { host } = new URL(endpointToUrl(endpoint));
+  return transportScheme === 'ws' ? `wss://${host}/apiws` : `https://${host}/apiw1`;
+}
+
+/**
+ * Builds the DC config for the relay endpoint. All DC ids resolve to the same
+ * endpoint; the relay routes per ticket/account on the server side, so the
+ * `downloadDC` (`-1`) distinction does not apply.
+ */
+function parseTelegramWebLiveEndpoint(endpoint: string, dcId: number) {
+  const url = new URL(endpointToUrl(endpoint));
+  const isInsecure = url.protocol === 'ws:' || url.protocol === 'http:';
+  return {
+    id: dcId,
+    ipAddress: url.hostname,
+    port: url.port ? Number(url.port) : (isInsecure ? 80 : 443),
+  };
+}
