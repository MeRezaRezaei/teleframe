includes:
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    level: 5
    paths:
        - src
    disallowedFunctionCalls:
        -
            function: 'preg_*'
            message: 'Regex is banned in the core teleframe engine. Use tokenizer or string funcs.'
            allowIn:
                - src/Laravel/*
                - src/Schema/*
                - src/Bot/*
    ignoreErrors:
        -
            # Consumed exclusively by the generated models (generated/), which
            # live OUTSIDE the src-only analysis paths — runtime-used traits
            # that phpstan's trait-unused check cannot see here.
            identifier: trait.unused
            reportUnmatched: false
            paths:
                - src/Schema/Eloquent/AccountScoped.php
                - src/Schema/Eloquent/HasTlChildren.php
                - src/Schema/Eloquent/PeerResolution.php
                - src/Teleframe/Vault/Concerns/HasTeleframe.php
