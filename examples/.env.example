# Copy to .env and fill in — NEVER commit .env (gitignored).
#
# Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_DC_ID=2

# Engine behavior
TELEFRAME_LIVE=false
TELEFRAME_LOGGER=
TELEFRAME_REDIS=predis
TELEFRAME_SCHEMA_SOURCES=
TELEFRAME_SHIP_NAMESPACES=

# Saved sessions (php artisan teleframe:login writes these)
TELEGRAM_USER_SESSION=
TELEGRAM_BOT_SESSION=

# Bot API / webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Vault default account label
TELEFRAME_DEFAULT_ACCOUNT_ID=

# Primary account (identity/account defaulting)
TELEFRAME_PRIMARY_ACCOUNT_ID=

# Identity layer
TELEFRAME_IDENTITY_DEFAULT_SENDER=
TELEFRAME_MINIAPP_AUTH_MAX_AGE=1800

# BotMap HMAC
TELEFRAME_BOTMAP_SECRET=

# Realtime (Centrifugo projection)
TELEFRAME_CENTRIFUGO_URL=
TELEFRAME_CENTRIFUGO_APIKEY=
TELEFRAME_CENTRIFUGO_SECRET=

# Dashboard
TELEFRAME_DASHBOARD_PREFIX=teleframe

# Embedded Telegram Web client
TELEGRAM_WEB_ENABLED=false
TELEGRAM_WEB_DIST=
TELEGRAM_WEB_LIVE_ENDPOINT=
TELEGRAM_RELAY_TICKET_TTL_MINUTES=10

# Backfill
TELEFRAME_BACKFILL_BUDGET=25

# Backup
TELEFRAME_BACKUP_DRIVER=telegram
TELEFRAME_BACKUP_ACCOUNT=
TELEFRAME_BACKUP_CHUNK_SIZE=4194304
TELEFRAME_BACKUP_PATHS=
TELEFRAME_BACKUP_PASSPHRASE=

# Live ladder: php bin/teleframe doctor → php bin/teleframe login → php bin/teleframe me → php bin/live-walkthrough.php → php bin/teleframe test-e2e